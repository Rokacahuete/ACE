---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Background from '../components/Background.astro';

import Logo from '../assets/favicon.png';
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href={Logo.src} />
		<meta name="generator" content={Astro.generator} />
		<title>ACE Transport</title>
	</head>
	<body>
		<div class="page">
			<header>
				<Header />
			</header>
			<Background />
			<main class="content centered">
				<slot />
			</main>
			<footer>
				<Footer />
			</footer>
		</div>
	</body>
</html>

<style>
	@font-face {
		font-family: "Super Dream";
		src: url("/ACE/fonts/SuperDream.ttf") format("truetype");
	}

	:global(*) {
		color: black;
	}

	:global(html) {
		--main-color: rgba(157, 171, 248, 0.5);
		--second-color: rgba(186, 201, 228, 0.5);
		--border-color: rgba(169, 169, 169, 0);
		--title-color: rgba(151, 151, 151, 0.5);
		--text-color: rgba(188, 190, 199, 0.5);
		
		--button-color: rgba(128, 128, 128, 0.5);
		--button-hover: rgb(155, 155, 155);

		--error-color: rgba(248, 104, 78, 0.5);
	}

	html, body {
		overflow-x: hidden;
		height: 100%;
		max-width: 2000px;
		margin: 0;
	}

	:global(.centered) {
		display: flex;
		align-items: center;
		text-align: center;
		flex-direction: column;
	}

    :global(.glass) {
        box-shadow : 0 4px 30px rgba(0, 0, 0, 0.1);
        backdrop-filter : blur(7px);
        -webkit-backdrop-filter : blur(7px);
    }

	.page {
		padding: 8px;
		min-height: calc(100vh - 16px);
		display: flex;
		flex-direction: column;
	}

	.content {
		margin-block: 30px 20px;
		flex: 1;
	}
</style>