---
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ACE Transport</title>
</head>

<body>
  <div class="background"></div>

  <header class="header">
    <h1>ACE Transport</h1>
    <p>Transport & logistique fiable</p>
  </header>

  <main class="sections-container">
    <section class="section glass">
      <h2>Logistique</h2>
      <div class="section-content">
        <div class="image-placeholder" style="background: linear-gradient(135deg, #d4a373, #f0e5d8);"></div>
        <p>Entreposage sécurisé des produits dans un entrepôt de plus de 20 000m²</p>
      </div>
    </section>

    <section class="section glass">
      <h2>Configuration</h2>
      <div class="section-content">
        <div class="image-placeholder" style="background: linear-gradient(135deg, #a0c4ff, #caf0f8);"></div>
        <p>Montage et configuration des machines, prêtes à l'emploi</p>
      </div>
    </section>

    <section class="section glass">
      <h2>Livraison</h2>
      <div class="section-content">
        <div class="image-placeholder" style="background: linear-gradient(135deg, #ffadad, #ffd6a5);"></div>
        <p>Toutes les machines sont livrées chez le client en 72h</p>
      </div>
    </section>

    <section class="section glass">
      <h2>Installation</h2>
      <div class="section-content">
        <div class="image-placeholder" style="background: linear-gradient(135deg, #b5ead7, #e2f0cb);"></div>
        <p>Les machines sont installées et testées chez le client</p>
      </div>
    </section>
  </main>

  <footer class="footer">
    © {year} ACE Transport
  </footer>
</body>
</html>

<style>
:root {
  --main-bg: #f2f2f2;
  --card-bg: rgba(255,255,255,0.65);
  --border: rgba(0,0,0,0.1);
  --text-main: #111;
  --text-soft: #555;
}

body, html {
  margin: 0;
  font-family: system-ui, sans-serif;
  min-height: 100%;
  background: var(--main-bg);
}

/* Background */
.background {
  position: fixed;
  inset: 0;
  background: linear-gradient(135deg, #f2f2f2, #d9d9d9);
  z-index: -1;
}

/* Header */
.header {
  text-align: center;
  padding: 3rem 1rem 2rem;
}

.header h1 {
  margin: 0;
  font-size: 2.5rem;
  letter-spacing: 0.08em;
}

.header p {
  margin: 0.5rem 0 0;
  color: var(--text-soft);
}

/* Sections */
.sections-container {
  display: flex;
  flex-direction: column;
  gap: 3rem;
  align-items: center;
  padding: 2rem 1rem 4rem;
}

.section {
  width: 100%;
  max-width: 700px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 24px;
  backdrop-filter: blur(10px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  padding: 2rem;
  text-align: center;
}

.section h2 {
  margin-top: 0;
}

.section-content {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-top: 1rem;
}

.image-placeholder {
  width: 100%;
  height: 200px;
  border-radius: 16px;
}

/* Footer */
.footer {
  text-align: center;
  padding: 2rem 1rem;
  color: var(--text-soft);
}
</style>
