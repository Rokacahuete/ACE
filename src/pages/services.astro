---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import SectionsContainer from '../components/SectionsContainer.astro';

import Logistique from '../assets/services/logistique.jpg';
import Assemblage from '../assets/services/assemblage.jpg';
import Parametrage from '../assets/services/parametrage.jpg';
import Locker from '../assets/services/locker.jpg';
import Livraison from '../assets/services/livraison.jpg';
import Installation from '../assets/services/installation.jpg';
import TraitementReverse from '../assets/services/reverse.jpg';
---

<Layout>
    <SectionsContainer>
        <Section title="Logistique" redirect="/ACE/services/logistique">
            <img src={Logistique.src} alt="">
        </Section>
        <Section title="Assemblage" redirect="/ACE/services/assemblage">
            <img src={Assemblage.src} alt="">
        </Section>
        <Section title="Paramétrage" redirect="/ACE/services/paramétrage">
            <img src={Parametrage.src} alt="">
        </Section>
        <Section title="Locker" redirect="/ACE/services/locker">
            <img src={Locker.src} alt="">
        </Section>
        <Section title="Livraison" redirect="/ACE/services/livraison">
            <img src={Livraison.src} alt="">
        </Section>
        <Section title="Installation" redirect="/ACE/services/installation">
            <img src={Installation.src} alt="">
        </Section>
        <Section title="Traitement Reverse" redirect="/ACE/services/traitement-reverse">
            <img src={TraitementReverse.src} alt="">
        </Section>
    </SectionsContainer>
</Layout>