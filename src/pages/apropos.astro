---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import SectionsContainer from "../components/SectionsContainer.astro";
import Text from "../components/Text.astro";
import Carousel from "../components/Carousel.astro";
import CarouselItem from "../components/CarouselItem.astro";

import ADS from "../assets/ADS.jpg";
import AS from "../assets/AS.jpg";
import CL from "../assets/CL.jpg";
import LP from "../assets/LP.jpg";
import PC from "../assets/PC.jpg";
import RS from "../assets/RS.jpg";
import SDS from "../assets/SDS.jpg";
import Button from "../components/Button.astro";
---

<Layout>
    <SectionsContainer>
        <Section title="ACE">
            <Text>
                Fondée en 1988, <b>ACE - Antony Courses Express</b> s'est développée à Champlan (Essonne) autour d'un objectif clair : proposer des solutions de transport et de logistique à échelle <b>nationnale</b>, <b>fiables</b> et <b>maîtrisées</b>. Depuis sa création, l'entreprise a évolué de manière continue, en adaptant ses <b>méthodes</b> et ses <b>outils</b> aux besoins de ses clients, tout en conservant une organisation à <b>taille humaine</b>.
            </Text>
        </Section>
    </SectionsContainer>
    <Carousel>
        <CarouselItem title="1988">
            <Text centered class="sous-titre">Création de la société</Text>
            <Text>
                Initialement basée sur le <b>transport express</b>, ACE contracte avec de nombreuses sociétés du marché <b>Bureautique</b>. Mr DOS SANTOS Antonio est alors gérant et créateur de la société.
            </Text>
        </CarouselItem>
        <CarouselItem title="1992">
            <Text centered class="sous-titre">Premier contrat avec un constructeur</Text>
            <Text>
                Contrat signé avec <b>RICOH</b>, ces derniers ont besoin d'un <b>fournisseur logistique</b> constitué d'une équipe de <b>deux livreurs-installateurs</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="1995">
            <Text centered class="sous-titre">Création de la branche Assemblage du matériel</Text>
            <Text>
                Ace reçoit les matériels en <b>pièces détachées</b> et propose à ses clients d'<b>assembler</b> les matériels pour livrer un matériel <b>fonctionnel</b> à l'arrivée chez le client final.
            </Text>
        </CarouselItem>
        <CarouselItem title="2000">
            <Text centered class="sous-titre">Création d'un atelier centralisé</Text>
            <Text>
                Cet atelier prend en charge de l'assemblage du matériel et du <b>paramétrage</b> technique.
            </Text>
        </CarouselItem>
        <CarouselItem title="2001">
            <Text centered class="sous-titre">Connexion du matériel</Text>
            <Text>
                ACE s'adapte à ses clients en mettant en place le service <b>mise en réseau</b> du matériel. ACE développe donc un service <b>global</b> sous le nom de <b>High Tech Supply Chain</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="2005">
            <Text centered class="sous-titre">Espace client</Text>
            <Text>
                Ouverture du <b>site Internet</b> permettant au client la <b>gestion</b> de son stock - le <b>suivi</b> de ses commandes - la <b>récupération</b> des éléments de livraison.
            </Text>
        </CarouselItem>
        <CarouselItem title="2006">
            <Text centered class="sous-titre">Développement de solutions embarquées</Text>
            <Text>
                Permettant le déploiement de <b>flottes</b> de matériels <b>entièrement</b> paramétrés et <b>livrés</b> selon le principe du <b>plug and play</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="2008">
            <Text centered class="sous-titre">Le prix RICOH</Text>
            <Text>
                ACE reçoit le <b>prix</b> de l'<b>innovation</b> et de la <b>qualité</b> de services. Délivré par des <b>leaders</b> dans leur secteur respectif (Canal+, Dassault, Gaz de France). Ce prix récompense la <b>volonté</b> de la part d'ACE a développer une <b>stratégie</b> commerciale <b>innovative</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="2010">
            <Text centered class="sous-titre">Diversification</Text>
            <Text>
                ACE continue dans sa <b>diversification</b> en signant un contrat avec <b>Neopost</b> pour l'installation de ses machines de <b>mise sous plis</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="2011">
            <Text centered class="sous-titre">Diversification</Text>
            <Text>
                ACE se tourne vers le <b>High-tech</b> grand public avec la livraison et l'installation (fixation) de <b>téléviseurs</b> dernière génération pour le compte de <b>Sony</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="2013">
            <Text centered class="sous-titre">Diversification</Text>
            <Text>
                Signature d'un contrat avec <b>Mail Services</b>. Ce contrat stipule l'<b>installation</b> de plus de <b>3000 locker Pack-City</b> dans toute la <b>France</b>.
            </Text>
        </CarouselItem>
    </Carousel>
    <SectionsContainer>
        <Section title="Notre équipe"></Section>
    </SectionsContainer>
    <SectionsContainer>
        <Section title="Antonio DOS SANTOS">
            <img src={ADS.src}>
            <Text centered class="sous-titre">Président</Text>
            <Text></Text>
        </Section>
        <Section title="Ludovic PLAYOUT">
            <img src={LP.src}>
            <Text centered class="sous-titre">Directeur Supply Chain</Text>
            <Text></Text>
        </Section>
    </SectionsContainer>
    <SectionsContainer>
        <Section title="Sandra DOS SANTOS">
            <img src={SDS.src}>
            <Text centered class="sous-titre">Responsable Administrative</Text>
            <Text></Text>
        </Section>
        <Section title="Carlos LOUREIRO">
            <img src={CL.src}>
            <Text centered class="sous-titre">Responsable Opérationnnel</Text>
            <Text></Text>
        </Section>
        <Section title="Adrien SIMOES">
            <img src={AS.src}>
            <Text centered class="sous-titre">Responsable Exploitation IDF</Text>
            <Text></Text>
        </Section>
    </SectionsContainer>
    <SectionsContainer>
        <Section title="Rabi SOUGUIR">
            <img src={RS.src}>
            <Text centered class="sous-titre">Responsable Technique</Text>
            <Text></Text>
        </Section>
        <Section title="Patrice CAPDEVILLA">
            <img src={PC.src}>
            <Text centered class="sous-titre">Responsable Réseau</Text>
            <Text></Text>
        </Section>
    </SectionsContainer>
    <SectionsContainer>
        <Section class="apropos-contact-section">
            <Button redirect="/ACE/contact" id="apropos-contact-button">Nous contacter</Button>
        </Section>
    </SectionsContainer>
</Layout>

<style>
    :global(.apropos-contact-section) {
        padding-block: 20px;
    }

    :global(#apropos-contact-button) {
        width: 100%;
    }

    :global(.sous-titre) {
		font-family: "Super Dream", sans-serif;
        margin-bottom: 10px;
    }
</style>