---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import SectionsContainer from "../components/SectionsContainer.astro";
import Text from "../components/Text.astro";
import Carousel from "../components/Carousel.astro";
import CarouselItem from "../components/CarouselItem.astro";

import ADS from "../assets/ADS.jpg";
import AS from "../assets/AS.jpg";
import CL from "../assets/CL.jpg";
import LP from "../assets/LP.jpg";
import PC from "../assets/PC.jpg";
import RS from "../assets/RS.jpg";
import SDS from "../assets/SDS.jpg";
import Button from "../components/Button.astro";
---

<Layout>
    <SectionsContainer>
        <Section title="ACE">
            <Text>
                Fondée en 1984, ACE - Antony Courses Express s'est développée à Champlan (Essonne) autour d'un objectif clair : proposer des solutions de transport et de logistique à échelle nationnale, fiables et maîtrisées. Depuis sa création, l'entreprise a évolué de manière continue, en adaptant ses méthodes et ses outils aux besoins de ses clients, tout en conservant une organisation à taille humaine.
            </Text>
        </Section>
    </SectionsContainer>
    <Carousel>
        <CarouselItem title="1984">
            <Text centered>Création de la société ACE</Text>
            <Text>
                Initialement basée sur le transport express, ACE contracte avec de nombreuses sociétés du marché « Bureautique ». Mr DOS SANTOS Antonio est alors gérant et créateur de la société.
            </Text>
        </CarouselItem>
        <CarouselItem title="1992">
            <Text>Contrat avec Ricoh France</Text>
            <Text>
                Ce dernier a besoin d'un fournisseur logistique constitué d'une équipe de deux livreurs-installateurs.
            </Text>
        </CarouselItem>
        <CarouselItem title="1995">
            <Text>Création de la branche « Préparation Matériel »</Text>
            <Text>
                Ace reçoit les matériels en pièces détachées et propose à ses clients d'assembler les matériels pour livrer un matériel fonctionnel à l'arrivée chez le client final.
            </Text>
        </CarouselItem>
        <CarouselItem title="2000">
            <Text>Création d'un atelier centralisé</Text>
            <Text>
                en charge de la préparation des matériels et de leur paramétrage technique.
            </Text>
        </CarouselItem>
        <CarouselItem title="2001">
            <Text>Connexion du matériel</Text>
            <Text>
                ACE s'adapte à ses clients en mettant en place le service « mise en réseau » du matériel. ACE développe donc un service global sous le nom de « High Tech Supply Chain ».
            </Text>
        </CarouselItem>
        <CarouselItem title="2005">
            <Text>Espace client</Text>
            <Text>
                Ouverture du site Internet permettant au client la gestion de son stock - le suivi de ces commandes - la récupération des éléments de livraison.
            </Text>
        </CarouselItem>
        <CarouselItem title="2006">
            <Text>Développement de solutions embarquées</Text>
            <Text>
                permettant le déploiement de flottes de matériels entièrement paramétrés et livrés selon le principe du « plug and play ».
            </Text>
        </CarouselItem>
        <CarouselItem title="2008">
            <Text>Le prix RICOH</Text>
            <Text>
                ACE reçoit le prix de l'innovation et de la qualité de services. Délivré par des leaders dans leur secteur respectif (Canal+, Dassault, Gaz de France). Ce prix récompense la volonté de la part d'ACE a développer une stratégie commerciale innovative.
            </Text>
        </CarouselItem>
        <CarouselItem title="2010">
            <Text>Diversification</Text>
            <Text>
                ACE continue dans sa diversification en signant un contrat avec Neopost pour l'installation de ses machines de « mise sous plis ».
            </Text>
        </CarouselItem>
        <CarouselItem title="2011">
            <Text>Diversification</Text>
            <Text>
                ACE se tourne vers le High-tech grand public avec la livraison et l'installation (fixation) de téléviseurs dernière génération pour le compte de Sony.
            </Text>
        </CarouselItem>
        <CarouselItem title="2013">
            <Text>Diversification</Text>
            <Text>
                Signature d'un contrat avec Mail Services. Ce contrat stipule l'installation de plus de 3000 « locker Pack-City » dans toute la France.
            </Text>
        </CarouselItem>
    </Carousel>
    <SectionsContainer>
        <Section title="Notre équipe"></Section>
    </SectionsContainer>
    <SectionsContainer>
        <Section title="Antonio DOS SANTOS">
            <img src={ADS.src}>
            <Text centered>Président</Text>
        </Section>
        <Section title="Ludovic PLAYOUT">
            <img src={LP.src}>
            <Text centered>Directeur Supply Chain</Text>
        </Section>
    </SectionsContainer>
    <SectionsContainer>
        <Section title="Sandra DOS SANTOS">
            <img src={SDS.src}>
            <Text centered>Responsable Administrative</Text>
        </Section>
        <Section title="Carlos LOUREIRO">
            <img src={CL.src}>
            <Text centered>Responsable Opérationnnel</Text>
        </Section>
        <Section title="Adrien SIMOES">
            <img src={AS.src}>
            <Text centered>Responsable Exploitation IDF</Text>
        </Section>
    </SectionsContainer>
    <SectionsContainer>
        <Section title="Rabi SOUGUIR">
            <img src={RS.src}>
            <Text centered>Responsable Technique</Text>
        </Section>
        <Section title="Patrice CAPDEVILLA">
            <img src={PC.src}>
            <Text centered>Responsable Réseau</Text>
        </Section>
    </SectionsContainer>
    <SectionsContainer>
        <Section class="apropos-contact-section">
            <Button redirect="/ACE/contact" id="apropos-contact-button">Nous contacter</Button>
        </Section>
    </SectionsContainer>
</Layout>

<style>
    :global(.apropos-contact-section) {
        padding-block: 20px;
    }

    :global(#apropos-contact-button) {
        width: 100%;
    }
</style>