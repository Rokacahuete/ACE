---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import SectionsContainer from "../components/SectionsContainer.astro";
import Text from "../components/Text.astro";
import Carousel from "../components/Carousel.astro";
import CarouselItem from "../components/CarouselItem.astro";
import CustomersSection from '../sections/Customers.astro';

import ADS from "../assets/direction/ADS.jpg";
import AS from "../assets/direction/AS.jpg";
import CL from "../assets/direction/CL.jpg";
import LP from "../assets/direction/LP.jpg";
import PC from "../assets/direction/PC.jpg";
import RS from "../assets/direction/RS.jpg";
import SDS from "../assets/direction/SDS.jpg";
import Button from "../components/Button.astro";
---

<Layout>
    <SectionsContainer>
        <Section title="Notre histoire">
            <Text>
                Nous sommes une entreprise <b>française</b> de <b>transport</b> routier, fondée en <b>1984</b> et basée en Île de France. Nous exerçons des activités de <b>transport</b>, <b>manutention</b>, <b>livraison</b> et <b>installation</b> de matériels <b>bureautiques</b>, notamment dans des contextes nécessitant <b>précision</b> et <b>fiabilité</b>.<br><br>

                Nous disposons d'infrastructures logistiques nous permettant d'assurer l'<b>entreposage</b>, la <b>préparation</b> et la <b>livraison</b> des équipements. Notre activité s'adresse essentiellement à une clientèle <b>professionnelle</b>, avec des prestations couvrant l'<b>ensemble</b> de la <b>chaîne logistique courte</b>, du stockage jusqu'à l'installation finale.
            </Text>
        </Section>
    </SectionsContainer>
    <Carousel>
        <CarouselItem title="1984">
            <Text centered class="sous-titre"><b>Création de la société</b></Text>
            <Text>
                Initialement basée sur le <b>transport express</b>, ACE contracte avec de nombreuses sociétés du marché <b>bureautique</b>. M DOS SANTOS Antonio est alors gérant et créateur de la société.
            </Text>
        </CarouselItem>
        <CarouselItem title="1992">
            <Text centered class="sous-titre"><b>Premier contrat avec un constructeur</b></Text>
            <Text>
                Contrat signé avec <b>RICOH</b>. Ces derniers ont besoin d'un <b>fournisseur logistique</b> constitué d'une équipe de <b>deux livreurs-installateurs</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="1995">
            <Text centered class="sous-titre"><b>Création de la branche Assemblage du matériel</b></Text>
            <Text>
                ACE reçoit les matériels en <b>pièces détachées</b> et propose à ses clients d'<b>assembler</b> les matériels pour livrer un matériel <b>fonctionnel</b> à l'arrivée chez le client final.
            </Text>
        </CarouselItem>
        <CarouselItem title="2000">
            <Text centered class="sous-titre"><b>Création d'un atelier centralisé</b></Text>
            <Text>
                Cet atelier prend en charge l'assemblage du matériel et le <b>paramétrage</b> technique.
            </Text>
        </CarouselItem>
        <CarouselItem title="2001">
            <Text centered class="sous-titre"><b>Connexion du matériel</b></Text>
            <Text>
                ACE s'adapte à ses clients en mettant en place le service de <b>mise en réseau</b> du matériel. ACE développe donc un service <b>global</b> sous le nom de <b>High Tech Supply Chain</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="2005">
            <Text centered class="sous-titre"><b>Espace client</b></Text>
            <Text>
                Ouverture du <b>site Internet</b> permettant au client la <b>gestion</b> de son stock - le <b>suivi</b> de ses commandes - la <b>récupération</b> des éléments de livraison.
            </Text>
        </CarouselItem>
        <CarouselItem title="2006">
            <Text centered class="sous-titre"><b>Développement de solutions embarquées</b></Text>
            <Text>
                Permettant le déploiement de <b>flottes</b> de matériels <b>entièrement</b> paramétrés et <b>livrés</b> selon le principe du <b>plug and play</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="2008">
            <Text centered class="sous-titre"><b>Le prix RICOH</b></Text>
            <Text>
                ACE reçoit le <b>prix</b> de l'<b>innovation</b> et de la <b>qualité</b> de services. Délivré par des <b>leaders</b> dans leur secteur respectif (Canal+, Dassault, Gaz de France). Ce prix récompense la <b>volonté</b> de la part d'ACE à développer une <b>stratégie</b> commerciale <b>innovante</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="2010">
            <Text centered class="sous-titre"><b>Diversification</b></Text>
            <Text>
                ACE continue dans sa <b>diversification</b> en signant un contrat avec <b>Neopost</b> pour l'installation de ses machines de <b>mise sous plis</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="2011">
            <Text centered class="sous-titre"><b>Diversification</b></Text>
            <Text>
                ACE se tourne vers le <b>High-tech</b> grand public avec la livraison et l'installation (fixation) de <b>téléviseurs</b> dernière génération pour le compte de <b>Sony</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="2013">
            <Text centered class="sous-titre"><b>Diversification</b></Text>
            <Text>
                Signature d'un contrat avec <b>Mail Services</b>. Ce contrat stipule l'<b>installation</b> de plus de <b>3 000 lockers Pack-City</b> dans toute la <b>France</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="2015">
            <Text centered class="sous-titre"><b>Traitement Reverse</b></Text>
            <Text>
                Ouverture d'un entrepôt de <b>5 000m²</b> dédié traitant exclusivement les process <b>Reverse</b>.
            </Text>
        </CarouselItem>
        <CarouselItem title="2018">
            <Text centered class="sous-titre"><b>One Go</b></Text>
            <Text>
                Développement des <b>connexions transporteur</b> sans intervention technicien postérieure.
            </Text>
        </CarouselItem>
        <CarouselItem title="2020">
            <Text centered class="sous-titre"><b>Crise du Covid</b></Text>
            <Text>
                Pendant le <b>confinement</b>, nous nous sommes <b>adaptés</b> en assurant la livraison de matériel de <b>première nécessité</b>, notamment des masques.
            </Text>
        </CarouselItem>
    </Carousel>
    <SectionsContainer>
        <Section title="Notre équipe"></Section>
    </SectionsContainer>
    <SectionsContainer>
        <Section title="Antonio DOS SANTOS">
            <img src={ADS.src}>
            <Text centered class="sous-titre"><b>Président</b></Text>
        </Section>
        <Section title="Ludovic PLAYOUT">
            <img src={LP.src}>
            <Text centered class="sous-titre"><b>Directeur Supply Chain</b></Text>
        </Section>
    </SectionsContainer>
    <SectionsContainer>
        <Section title="Sandra DOS SANTOS">
            <img src={SDS.src} style="max-height: 250px;">
            <Text centered class="sous-titre"><b>Responsable administrative</b></Text>
        </Section>
        <Section title="Carlos LOUREIRO">
            <img src={CL.src} style="max-height: 250px;">
            <Text centered class="sous-titre"><b>Responsable opérationnel</b></Text>
        </Section>
        <Section title="Adrien SIMOES">
            <img src={AS.src} style="max-height: 250px;">
            <Text centered class="sous-titre"><b>Responsable exploitation IDF</b></Text>
        </Section>
    </SectionsContainer>
    <SectionsContainer>
        <Section title="Rabi SOUGUIR">
            <img src={RS.src} style="max-height: 250px;">
            <Text centered class="sous-titre"><b>Responsable technique</b></Text>
        </Section>
        <Section title="Patrice CAPDEVILLA">
            <img src={PC.src} style="max-height: 250px;">
            <Text centered class="sous-titre"><b>Responsable réseau</b></Text>
        </Section>
    </SectionsContainer>
	<CustomersSection />
</Layout>

<style>
    :global(.apropos-contact-section) {
        padding-block: 20px;
    }

    :global(#apropos-contact-button) {
        width: 100%;
    }

    :global(.sous-titre) {
        text-align: center;
        margin-bottom: 10px;
    }
</style>