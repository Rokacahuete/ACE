---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import SectionsContainer from "../../components/SectionsContainer.astro";
import Text from "../../components/Text.astro";
import Button from "../../components/Button.astro";
---

<Layout>
    <SectionsContainer>
        <Section title="Paramétrage">
            <Text>
                <b>INTEGRATION ELEMENTS DE PARAMETRAGE DANS ERP</b><br>
                <b>PILOTAGE DE PROJETS</b><br>
                Identification <b>automatique</b> des commandes avec <b>paramétrage</b> spécifique<br>
                Construction à façon de <b>canevas</b> de préparation spécifique<br>
                Intégration et Edition automatisées de <b>PV Spécifique</b><br><br>
                
                <b>MODELING</b><br>
                <b>DU PLUS SIMPLE AU PLUS COMPLEXE</b><br>
                <b>Construction</b> de Master de <b>Clonage</b><br>
                Upload des fichiers de <b>masterisation</b><br>
                Montage de <b>solution</b> d'identification (lecteur…)<br>
                <b>Intégration</b> des politiques d'impression<br><br>

                <b>PERSONNALISATION</b><br>
                <b>INTEGRATION DES PARAMETRAGES VARIABLES</b><br>
                Personnalisation <b>mécanique</b> (Magasin - Finition - …)<br>
                <b>Intégration</b> des données <b>reseau</b> Variables (IP - DNS - Mail - …)
            </Text>
            <div class="buttons-container">
                <Button redirect="/ACE/services/assemblage">‹ Assemblage</Button>
                <Button redirect="/ACE/services/livraison">Livraison ›</Button>
            </div>
        </Section>
    </SectionsContainer>
</Layout>

<style>
    .buttons-container {
        display: flex;
        gap: 100px;
        margin-block: 10px;
    }

    :global(.buttons-container>.button) {
        width: 200px;
    }
</style>