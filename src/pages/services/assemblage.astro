---
import Button from "../../components/Button.astro";
import Section from "../../components/Section.astro";
import SectionsContainer from "../../components/SectionsContainer.astro";
import Text from "../../components/Text.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <SectionsContainer>
        <Section>
            <Text>
                Habilitations et Agréments Constructeurs<br>
                CANON - HP - KONICA - KYOCERA - LEXMARK - OKI - RICOH - SAMSUNG - XEROX<br><br>

                Compétences sur une large gamme<br>
                Montage - Assemblage - Test Fonctionnement sur une large gamme (Printer 🡺 MFP A3 Couleur)<br><br>

                Enregistrement des Tests réalisés sur chaque Machine<br>
                Test Fonctionnement Matériel en configuration d'utilisation (Recto Verso - Alimentation Papier - Chargeur - …) + Enregistrement Page de Configuration + Mise à disposition des informations sur Portail Web
            </Text>
            <div class="buttons-container">
                <Button redirect="/ACE/services/logistique">‹ Logistique</Button>
                <Button redirect="/ACE/services/paramétrage">Paramétrage ›</Button>
            </div>
        </Section>
    </SectionsContainer>
</Layout>

<style>
    .buttons-container {
        display: flex;
        gap: 100px;
        margin-block: 10px;
    }

    :global(.buttons-container>.button) {
        width: 200px;
    }
</style>