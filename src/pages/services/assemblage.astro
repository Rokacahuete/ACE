---
import Button from "../../components/Button.astro";
import Section from "../../components/Section.astro";
import SectionsContainer from "../../components/SectionsContainer.astro";
import Text from "../../components/Text.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <SectionsContainer>
        <Section title="Assemblage">
            <Text>
                <b>LARGE GAMME D'INTERVENTION</b><br>
                <b>Montage</b> - <b>Assemblage</b> - <b>Test</b> Fonctionnement sur une <b>large gamme</b> (Printer 🡺 MFP A3 Couleur)<br>
                Test de fonctionnement matériel - <b>Traçabilité</b> et <b>communication</b> des tests réalisés<br><br>

                <b>HABILITATIONS CONSTRUCTEURS</b><br>
                CANON - HP - KONICA - KYOCERA - LEXMARK - OKI - RICOH - SAMSUNG - SHARP - XEROX
            </Text>
            <div class="buttons-container">
                <Button redirect="/ACE/services/logistique">‹ Logistique</Button>
                <Button redirect="/ACE/services/paramétrage">Paramétrage ›</Button>
            </div>
        </Section>
    </SectionsContainer>
</Layout>

<style>
    .buttons-container {
        display: flex;
        gap: 100px;
        margin-block: 10px;
    }

    :global(.buttons-container>.button) {
        width: 200px;
    }
</style>