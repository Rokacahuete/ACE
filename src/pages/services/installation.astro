---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import SectionsContainer from "../../components/SectionsContainer.astro";
import Text from "../../components/Text.astro";
import Button from "../../components/Button.astro";
---

<Layout>
    <SectionsContainer>
        <Section title="Installation">
            <Text>
                <b>PERSONNEL INTERVENANT</b><br>
                <b>HABILITATIONS - FORMATIONS</b><br>
                Prestations assurées par équipage de <b>2 personnes</b> permettant la <b>manutention</b> des matériels sur site<br>
                Procédure <b>Accueil</b> et Formation - Suivi Annuel - <b>Manutention</b> - <b>Habilitation</b> électrique<br><br>

                <b>REMONTEE D'INFORMATION</b><br>
                <b>TEMPS RÉEL IMPÉRATIF</b><br>
                <b>Signature électronique</b> - Prise de <b>Photos</b><br>
                <b>Compte rendu</b> d'intervention réseau
            </Text>
            <div class="buttons-container">
                <Button redirect="/ACE/services/livraison">‹ Livraison</Button>
                <Button redirect="/ACE/services/traitement-reverse">Traitement Reverse ›</Button>
            </div>
        </Section>
    </SectionsContainer>
</Layout>

<style>
    .buttons-container {
        display: flex;
        gap: 100px;
        margin-block: 10px;
    }

    :global(.buttons-container>.button) {
        width: 200px;
    }
</style>