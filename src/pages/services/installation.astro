---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import SectionsContainer from "../../components/SectionsContainer.astro";
import Text from "../../components/Text.astro";
import Button from "../../components/Button.astro";
---

<Layout>
    <SectionsContainer>
        <Section>
            <Text>
                Equipage de 2 Personnes<br>
                Prestations assurées par équipage de 2 Personnes permettant la manutention des matériels sur site<br><br>
                
                Formation des équipages<br>
                Formation technique - Manutention - Habilitation électrique<br><br>
                
                Personnel équipé pour des interventions sur site professionnelles<br>
                Outillage - Equipements de Protection - Moyens d'emballage<br><br>
                
                Moyens de Manutention automatisés<br>
                Diables électriques permettant la manutention aisée en escalier<br><br>
                
                Mise en œuvre de moyens et solutions exceptionnelles<br>
                Manutention Lourde - Protection Bâtiment - Grutage - …<br><br>
                
                Connexion du matériel sur Réseau Client<br>
                Paramétrage sur Site - Contact DSI - Validation Fonctionnalité<br><br>
                
                Installation Driver / Pilote Impression<br>
                Poste à Poste - Serveur Impression - Environnement Windows / Mac<br><br>
                
                Contrôles des fonctionnalités avancées<br>
                Carnet d'adresses (Réseau ou local) - Contrôles Accès (lecteur de badge) - Remontée consommables (Kpax -…)
            </Text>
            <div class="buttons-container">
                <Button redirect="/ACE/services/livraison">Livraison</Button>
                <Button redirect="/ACE/services/traitement-reverse">Traitement Reverse</Button>
            </div>
        </Section>
    </SectionsContainer>
</Layout>

<style>
    .buttons-container {
        display: flex;
        gap: 100px;
        margin-bottom: 10px;
    }
</style>