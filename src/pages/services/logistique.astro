---
import Button from "../../components/Button.astro";
import Section from "../../components/Section.astro";
import SectionsContainer from "../../components/SectionsContainer.astro";
import Text from "../../components/Text.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <SectionsContainer>
        <Section title="Logistique">
            <Text>
                <b>13 ENTREPOTS EN FRANCE</b><br>
                Maillage idéal pour couvrir l'ensemble du <b>territoire</b><br><br>
                
                <b>BIEN RÉCEPTIONNER POUR BIEN DÉMARRER</b><br><br>
                <b>25 000 m²</b> de stockage dédiés bureautique<br>
                <b>Sécurisés</b> avec contrôles d'accès et vidéo-surveillance<br>
                Rack de Stockage - Couverture Wi-Fi sur l'ensemble des dépôts<br><br>

                <b>Nos Process</b> - <b>Nos Outils</b><br><br>

                Lecture code-barres constructeur en <b>réception</b> -<br>
                <b>Localisation</b> informatisée - <b>Préparation</b> automatisée -<br>
                <b>Contrôles</b> de stock - Inventaire
            </Text>
            <div class="buttons-container">
                <Button redirect="/ACE/services/assemblage" class="next-button">Assemblage ›</Button>
            </div>
        </Section>
    </SectionsContainer>
</Layout>

<style>
    .buttons-container {
        display: flex;
        gap: 100px;
        margin-block: 10px;
    }

    :global(.buttons-container>.button) {
        width: 200px;
    }
</style>