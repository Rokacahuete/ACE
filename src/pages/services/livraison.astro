---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import SectionsContainer from "../../components/SectionsContainer.astro";
import Text from "../../components/Text.astro";
import Button from "../../components/Button.astro";
---

<Layout>
    <SectionsContainer>
        <Section title="Livraison">
            <Text>
                <b>TRANSPORT</b><br>
                <b>13 AGENCES EN FRANCE</b><br>
                <b>Aucune</b> Sous-traitance dans la <b>distribution</b> de vos produits<br>
                Navettes Inter Agences <b>Quotidiennes</b><br>
                Equipements <b>véhicules</b> : Hayons élévateurs - Capitonnage intégral - Rails d'arrimage sur 3 niveaux
            </Text>
            <div class="buttons-container">
                <Button redirect="/ACE/services/paramétrage">‹ Paramétrage</Button>
                <Button redirect="/ACE/services/installation">Lnstallation ›</Button>
            </div>
        </Section>
    </SectionsContainer>
</Layout>

<style>
    .buttons-container {
        display: flex;
        gap: 100px;
        margin-block: 10px;
    }

    :global(.buttons-container>.button) {
        width: 200px;
    }
</style>