---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import SectionsContainer from "../../components/SectionsContainer.astro";
import Text from "../../components/Text.astro";
import Button from "../../components/Button.astro";
---

<Layout>
    <SectionsContainer>
        <Section title="Traitement Reverse">
            <Text>
                <b>DES PROCESS SPECIFIQUES DEDIES REVERSE</b><br>
                Tous les <b>compteurs</b> des matériels repris sont <b>enregistrés</b> dans notre Erp et mis à <b>disposition</b> sur nos <b>outils</b> de suivi (EDI - Site Web - …)<br>
                Process d'<b>orientation</b> des produits selon <b>Information</b> Client ou <b>règles</b> définies<br><br>

                <b>CONDITIONNEMENT ADAPTE</b><br>
                <b>PRISE EN COMPTE DE LA 2nde VIE</b><br>
                Bull Pack - Cornières - Film<br>
                <b>Enregistrement</b> Informatique des <b>entrées</b> en stock<br>
                <b>Refurbishing</b><br><br>

                <b>TRAITEMENT DE LA DONNEE SECURISEE</b><br>
                <b>DES OUTILS FIABLES ET SECURISANTS</b><br>
                Démontage HDD<br>
                Formatage HDD<br>
                Data Eraser avec <b>Certificat</b>
            </Text>
            <div class="buttons-container">
                <Button redirect="/ACE/services/installation">‹ Installation</Button>
                <Button redirect="/ACE/services/locker">Locker ›</Button>
            </div>
        </Section>
    </SectionsContainer>
</Layout>

<style>
    .buttons-container {
        display: flex;
        gap: 100px;
        margin-block: 10px;
    }

    :global(.buttons-container>.button) {
        width: 200px;
    }
</style>