---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro'
import Text from '../components/Text.astro';
import Banner from '../components/Banner.astro';

import SupplyChain from '../sections/SupplyChain.astro';
import Datas from '../sections/datas.astro';
---

<Layout>
	<Banner />
	<Section title="Présentation" class="home-section">
		<Text>
			Fondée en 1984, nous nous sommes développé à Champlan en Essonne autour d'un objectif clair : proposer des solutions de transport et de logistique à échelle <b>nationnale</b>, <b>fiables</b> et <b>maîtrisées</b>. Depuis notre création, nous avons évolué de manière continue, en adaptant nos <b>méthodes</b> et nos <b>outils</b> aux besoins de nos clients, tout en conservant une organisation à <b>taille humaine</b>.
		</Text>
	</Section>
	<SupplyChain />
	<Datas />
</Layout>

<style>
	:global(.section-container.home-section) {
		width: 90%;
		margin-inline: auto;
		margin-bottom: 10px;
	}
	
	:global(.section-container.home-section .button) {
		width: 85%;
		margin-bottom: 10px;
	}
</style>