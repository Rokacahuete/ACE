---
const { centered, class:classList } = Astro.props;
---

<div class=`text ${centered ? "centered" : ""} ${classList ?? ""}`>
    <slot></slot>
</div>

<style>
    .text {
        text-align: left;
        padding: 20px;
        width: 80%;
        background-color: var(--text-color);
        border: 4px solid var(--border-color);
        border-radius: 5px;
        margin-inline: auto;
    }
</style>