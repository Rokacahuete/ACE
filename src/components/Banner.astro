---
import Img1 from '../assets/3125.jpg';
import Img2 from '../assets/IMG_5113.jpg';
import Img3 from '../assets/IMG_5100.jpg';
import Img4 from '../assets/IMG_0549.jpg';
---

<div class="banner-container">
    <div class="track" id="track">
        <img class = "banner" data-images={[
            Img1.src,
            Img2.src,
            Img3.src,
            Img4.src
        ].join(',')}
        data-positions={["center 69%", "center 53%", "center 55%", "center 50%"].join(',')} src={Img1.src} id="banner" alt="">
        <img class = "next" src={Img2.src} id="next" alt="">
    </div>
</div>

<style>
	.banner-container {
		margin: 20px auto;
		width: 95%;
		height: 30vh;
		border-radius: 20px;
		border: 7px solid var(--border-color);
  		box-sizing: border-box;
        overflow: hidden;
	}

    .track {
        display: flex;
        width: 200%;
        height: 100%;
    }
    .track.transition {
        transform: translateX(-50%);

        transition: transform 3s ease-in-out;
    }

	img {
		width: 50%;
        height: 100%;
		object-fit: cover;
		object-position: center 69%;
	}
</style>

<script>
(() => {
    const track = document.getElementById("track") as HTMLImageElement;
    const banner = document.getElementById("banner") as HTMLImageElement;
    const next = document.getElementById("next") as HTMLImageElement;
    if (!track || !banner || !next) return;

    const images = banner.dataset.images?.split(',');
    const positions = banner.dataset.positions?.split(',');
    if (!images || !positions || images.length <= 0) return;
    positions.length = images.length;
    
    next.src = images[1];
    next.style.objectPosition = positions[1];

    setInterval(() => {
        track.classList.add("transition");
        track.offsetWidth;
    }, 5_000);
    
    let index = 1;
    track.addEventListener("transitionend", (transition) => {
        track.classList.remove("transition");
        track.offsetWidth;

        banner.src = next.src;
        banner.style.objectPosition = positions[index];
        
        index = (index + 1)%images.length;
        next.src = images[index];
        next.style.objectPosition = positions[index];
    });
})();
</script>