---
import Text from "./Text.astro"
---

<div class = "container glass centered">
    <div class="contact">
        <a href="tel:+33164478720"><Text centered>Tel : 01-64-47-87-20</Text></a>
        <a href="mailto:ace@ace-transport.com"><Text centered>E-mail : ace@ace-transport.com</Text></a>
        <a href="https://www.google.com/maps/place/Antony+Courses+Express/@48.6974268,2.2788979,13.25z/data=!4m6!3m5!1s0x47e677dcbc0a26ad:0x663d6ab9634a1b18!8m2!3d48.7047335!4d2.2910648!16s%2Fg%2F1trpkj89?entry=ttu&g_ep=EgoyMDI2MDEyMC4wIKXMDSoKLDEwMDc5MjA3MUgBUAM%3D" target="_blank" rel="noopener noreferrer"><Text centered>1 rue du chemin blanc, 91160 Champlan</Text></a>
    </div>
</div>

<style>
    .container {
        width: calc(100% - 20px);
        background-color: var(--main-color);
        border: 10px solid var(--border-color);
        border-radius: 15px;
    }

	h1 {
		background-color: rgba(128, 128, 128, 0.5);
		border: 4px solid var(--border-color);
		border-radius: 10px;
		padding: 5px 0px;
		width: 90%;
	}

    .contact {
        width: 90%;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0px 20px;
        padding: 5px;
    }

    .contact a {
		font-family: "Super Dream", sans-serif;
        flex: 1 1 300px;

        transition: transform .3s;
    }
    .contact a:hover {
        transform: scale(1.1);
    }

    :global(.contact .text) {
        margin-block: 5px;
    }
</style>