---
import Layout from "../layouts/Layout.astro";
import SectionsContainer from "../components/SectionsContainer.astro";
import Section from "../components/Section.astro";

import Tree from "../assets/Tree.png";
import Amazon from "../assets/logos-clients/amazon.png";
import PackCity from "../assets/logos-clients/pack-city.png";
import Quadient from "../assets/logos-clients/quadient.png";
import Sharp from "../assets/logos-clients/sharp.png";
import Toshiba from "../assets/logos-clients/toshiba.png";
import Canon from "../assets/logos-clients/canon.png";
import DocumentStore from "../assets/logos-clients/document-store.png";
import Factoria from "../assets/logos-clients/factoria.png";
import GroupeDFM from "../assets/logos-clients/groupe-dfm.png";
import HP from "../assets/logos-clients/hp.png";
import Kyocera from "../assets/logos-clients/kyocera.png";
import Lexmark from "../assets/logos-clients/lexmark.png";
import NGI from "../assets/logos-clients/ngi.png";
import OKI from "../assets/logos-clients/oki.png";
import Ricoh from "../assets/logos-clients/ricoh.png";
import Samsung from "../assets/logos-clients/samsung.png";
import SCC from "../assets/logos-clients/scc.png";
import Xerox from "../assets/logos-clients/xerox.png";
---

<SectionsContainer>
    <Section title="Ils nous font déjà confinace">
        <div class="customers-container">
            <img src={Tree.src} alt="" class="tree">
        
            <a style="top: 40%; left: 35%;" role="button">
                <img src={Ricoh.src} alt="Logo Ricoh" class="logo-customer">
            </a>
            <a style="top: 30%; left: 48%;" role="button">
                <img src={SCC.src} alt="Logo SCC" class="logo-customer">
            </a>
            <a style="top: 33%; left: 68%;" role="button">
                <img src={Kyocera.src} alt="Logo Kyocera" class="logo-customer">
            </a>
            <a style="top: 27%; left: 30%;" role="button">
                <img src={Quadient.src} alt="Logo Quadient" class="logo-customer">
            </a>
            <a style="top: 24%; left: 62%;" role="button">
                <img src={Toshiba.src} alt="Logo Toshiba" class="logo-customer">
            </a>
            <a style="top: 48%; left: 45%;" role="button">
                <img src={Amazon.src} alt="Logo Amazon" class="logo-customer">
            </a>
            <a style="top: 45%; left: 75%;" role="button">
                <img src={PackCity.src} alt="Logo Pack City" class="logo-customer">
            </a>
            <a style="top: 52%; left: 68%;" role="button">
                <img src={Sharp.src} alt="Logo Sharp" class="logo-customer">
            </a>
            <a style="top: 58%; left: 75%;" role="button">
                <img src={Xerox.src} alt="Logo Xerox" class="logo-customer">
            </a>
            <a style="top: 46%; left: 28%;" role="button">
                <img src={Factoria.src} alt="Logo" class="logo-customer">
            </a>
            <a style="top: 70%; left: 45%;" role="button">
                <img src={DocumentStore.src} alt="Logo Document Store" class="logo-customer">
            </a>
            <a style="top: 30%; left: 82%;" role="button">
                <img src={Canon.src} alt="Logo Canon" class="logo-customer">
            </a>
            <a style="top: 33%; left: 15%;" role="button">
                <img src={Lexmark.src} alt="Logo Lexmark" class="logo-customer">
            </a>
            <a style="top: 43%; left: 14%;" role="button">
                <img src={Samsung.src} alt="Logo Samsung" class="logo-customer">
            </a>
            <a style="top: 60%; left: 33%;" role="button">
                <img src={HP.src} alt="Logo HP" class="logo-customer">
            </a>
            <a style="top: 51.7%; left: 23%;" role="button">
                <img src={GroupeDFM.src} alt="Logo Groupe DFM" class="logo-customer">
            </a>
            <a style="top: 15%; left: 55%;" role="button">
                <img src={NGI.src} alt="Logo NGI" class="logo-customer">
            </a>
            <a style="top: 62%; left: 18%;" role="button">
                <img src={OKI.src} alt="Logo OKI" class="logo-customer">
            </a>
        </div>
    </Section>
</SectionsContainer>

<style>
    .customers-container {
        width: 50%;
        height: auto;
        position: relative;
    }

    .tree {
        position: relative;
        background-color: var(--text-color);
        width: 100%;
        height: auto;
        max-height: none;
    }

    a {
        padding: 1%;
        border-radius: 5px;
		background-color: var(--button-color);
        position: absolute;
        width: 12%;
        height: auto;
        translate: -50% -50%;
		transition: transform .2s, background-color .2s;
    }

    a:hover {
        z-index: 1;
        transform: scale(1.3);
		background-color: var(--button-hover);
    }

    .logo-customer {
        border: none;
        border-radius: 0;
        width: 100%;
        height: auto;
        margin: 0;
        transition: transform .2s;
    }
    .logo-customer:hover {
    }
</style>