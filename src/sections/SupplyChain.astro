---
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";

import Background from '../assets/supply-chain/background.png';
import LogoLogistique from "../assets/supply-chain/logo-logistique.png";
import LogoAssemblage from "../assets/supply-chain/logo-assemblage.png";
import LogoParametrage from "../assets/supply-chain/logo-paramétrage.png";
import LogoLivraison from "../assets/supply-chain/logo-livraison.png";
import LogoInstallation from "../assets/supply-chain/logo-installation.png";
import LogoTraitementReverse from "../assets/supply-chain/logo-traitement-reverse.png";
import LogoLocker from "../assets/supply-chain/logo-locker.png";
import LogoBorne from "../assets/supply-chain/logo-borne.png";
---

<Section class="home-section">
    <div class="services-buttons-container">
        <img src={Background.src} alt="" class="supply-chain">

        <a href="/ACE/services/logistique" class="service-button" style="top: 18.5%; left: 21%;" role="button">
            <img src={LogoLogistique.src} alt="Logo logistique" class="service-logo" data-hover="service-text-logistique">
        </a>
        <div class="service-text" style="top: 15.5%; left: 21%;" id="service-text-logistique">Logistique</div>

        <a href="/ACE/services/assemblage" class="service-button" style="top: 55%; left: 30.3%;" role="button">
            <img src={LogoAssemblage.src} alt="Logo assemblage" class="service-logo" data-hover="service-text-assemblage">
        </a>
        <div class="service-text" style="top: 68%; left: 30.3%;" id="service-text-assemblage">Assemblage</div>

        <a href="/ACE/services/paramétrage" class="service-button" style="top: 55%; left: 37.3%;" role="button">
            <img src={LogoParametrage.src} alt="Logo paramétrage" class="service-logo" data-hover="service-text-parametrage">
        </a>
        <div class="service-text" style="top: 68%; left: 38%;" id="service-text-parametrage">Paramétrage</div>

        <a href="/ACE/services/livraison" class="service-button" style="top: 52%; left: 51%;" role="button">
            <img src={LogoLivraison.src} alt="Logo livraison" class="service-logo" data-hover="service-text-livraison">
        </a>
        <div class="service-text" style="top: 65%; left: 51%;" id="service-text-livraison">Livraison</div>

        <a href="/ACE/services/locker" class="service-button" style="top: 14%; left: 71%;" role="button">
            <img src={LogoLocker.src} alt="Logo locker" class="service-logo" data-hover="service-text-locker">
        </a>
        <div class="service-text" style="top: 11%; left: 71%;" id="service-text-locker">Locker</div>

        <a href="/ACE/services/installation" class="service-button" style="top: 35%; left: 84.4%;" role="button">
            <img src={LogoInstallation.src} alt="Logo installation" class="service-logo" data-hover="service-text-installation">
        </a>
        <div class="service-text" style="top: 28%; left: 84.8%;" id="service-text-installation">Installation</div>

        <a href="/ACE/services/traitement-reverse" class="service-button" style="top: 73%; left: 78%;" role="button">
            <img src={LogoTraitementReverse.src} alt="Logo traitement reverse" class="service-logo" data-hover="service-text-reverse">
        </a>
        <div class="service-text" style="top: 70%; left: 83%;" id="service-text-reverse">Traitement reverse</div>
    </div>
</Section>

<style>
	.services-buttons-container {
		position: relative;
		width: 80%;
		margin-bottom: 10px;
	}

	.service-button {
		position: absolute;
		width: 5%;
		height: 9%;
		border-radius: 50%;
		transform: translateX(-50%);
	}

    .service-logo {
		background-color: var(--button-color);
		width: 100%;
		height: 100%;
		transition: transform .2s, background-color .2s;
    }
	.service-logo:hover {
		background-color: var(--button-hover);
		transform: scale(1.1);
	}

	.service-text {
		opacity: 0;
		position: absolute;
		transform: translate(-50%, -50%);
		white-space: nowrap;
		background-color: rgb(151, 151, 151);
		padding: 2px 20px;
		border: 2px solid var(--border-color);
		border-radius: 10px;

		transition: opacity 0.3s;
	}

	@media (max-width: 1048px) {
		.service-text {
			display: none;
		}
	}

	.supply-chain {
		width: calc(100% - 10px);
		height: auto;
		max-height: none;
		margin: 0;
		background-color: var(--text-color);
	}

	:global(#supply-chain-contact) {
		background-color: var(--title-color);
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>(".service-logo").forEach(logo => {
		logo.addEventListener("mouseenter", () => document.getElementById(logo.dataset.hover ?? "")?.style.setProperty("opacity", "1"));
		logo.addEventListener("mouseleave", () => document.getElementById(logo.dataset.hover ?? "")?.style.setProperty("opacity", "0"));
	});
</script>