---
import Section from "../components/Section.astro";
import SectionsContainer from "../components/SectionsContainer.astro";

import Map from "../assets/map.png";
import Text from "../components/Text.astro";
---

<SectionsContainer>
    <div class="map-container">
        <img src={Map.src} class="map" alt="Carte des agences">
    </div>
    <Section title="ACE en quelques chiffres" id="datas">
        <Text>
            <table>
                <tr>
                    <td>13</td>
                    <td>agences</td>
                </tr>
                <tr>
                    <td>500</td>
                    <td>mouvements par jour</td>
                </tr>
                <tr>
                    <td>150</td>
                    <td>salariés</td>
                </tr>
                <tr>
                    <td>100%</td>
                    <td>CDI</td>
                </tr>
                <tr>
                    <td>3,4j</td>
                    <td>de délai en moyenne</td>
                </tr>
                <tr>
                    <td>25 000m²</td>
                    <td>de stockage</td>
                </tr>
                <tr>
                    <td>13 000 000€</td>
                    <td>de CA</td>
                </tr>
                <tr>
                    <td>40 ans</td>
                    <td>d'existance</td>
                </tr>
            </table>
        </Text>
        <!-- <Text centered>Liste de nos agences :</Text>
        <Text>Arras, Sotteville les Rouen, Rennes, Cholet, Bruges, Montauban, Rousset, Mions, Gannat, Dijon, Woippy, Champlan, Les Ulis</Text> -->
    </Section>
</SectionsContainer>

<style>
    :global(#datas .text) {
		margin-top: 0;
    }

    .map-container {
        position: relative;
        max-width: 50%;
    }

    .map {
        width: 100%;
        height: auto;
    }
    
    tr>td:first-child {
		font-family: "Super Dream", sans-serif;
        padding-right: 20px;
        font-size: 24px;
        text-align: center;
    }

    tr>td {
    }
</style>