---
import Section from "../components/Section.astro";
import SectionsContainer from "../components/SectionsContainer.astro";

import Map from "../assets/map.png";
import Text from "../components/Text.astro";
---

<SectionsContainer>
    <div class="map-container">
        <img src={Map.src} class="map" alt="Carte des agences">
    </div>
    <Section title="ACE en quelques chiffres" id="datas">
        <Text>
            <table>
                <tr>
                    <td><b>13</b></td>
                    <td>agences</td>
                </tr>
                <tr>
                    <td><b>500</b></td>
                    <td>mouvements par jour</td>
                </tr>
                <tr>
                    <td><b>150</b></td>
                    <td>salariés</td>
                </tr>
                <tr>
                    <td><b>100%</b></td>
                    <td>CDI</td>
                </tr>
                <tr>
                    <td><b>3,4j</b></td>
                    <td>de délai moyen</td>
                </tr>
                <tr>
                    <td><b>25 000m²</b></td>
                    <td>de stockage</td>
                </tr>
                <tr>
                    <td><b>13 000 000€</b></td>
                    <td>de CA</td>
                </tr>
                <tr>
                    <td><b>40 ans</b></td>
                    <td>d'existence</td>
                </tr>
            </table>
        </Text>
        <!-- <Text centered>Liste de nos agences :</Text>
        <Text>Arras, Sotteville les Rouen, Rennes, Cholet, Bruges, Montauban, Rousset, Mions, Gannat, Dijon, Woippy, Champlan, Les Ulis</Text> -->
    </Section>
</SectionsContainer>

<style>
    :global(#datas .text) {
		margin-top: 0;
    }

    .map-container {
        position: relative;
        max-width: 50%;
    }

    .map {
        width: 100%;
        height: auto;
    }
    
    tr>td:first-child {
        padding-right: 20px;
        font-size: 24px;
        text-align: center;
    }

    tr>td {
    }
</style>